{
  "name": "izicrm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Telegram-бот персонального учёта балансов карт и P&L. Только RUB.",
  "scripts": {
    "dev": "node --import tsx src/main.ts",
    "test": "vitest run",
    "test:int": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "migrate:up": "node-pg-migrate up --database-url-var DATABASE_MIGRATOR_URL",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@testcontainers/postgresql": "11.5.1",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "4.0.0",
    "eslint": "9.33.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vitest": "4.0.0"
  },
  "dependencies": {
    "@office-kit/xlsx": "0.9.0",
    "decimal.js": "10.6.0",
    "grammy": "1.45.1",
    "kysely": "0.29.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "vite": "6.3.5"
  }
}
