# Токен бота от @BotFather. Не коммитить настоящее значение.
TELEGRAM_BOT_TOKEN=

# Опционально: HTTP/SOCKS5-прокси до Telegram API (если с сервера api.telegram.org недоступен).
# Пример: http://user:pass@host:8000
TELEGRAM_PROXY_URL=

# Пароли ролей. Compose подставляет их в URL внутри сети Docker.
POSTGRES_PASSWORD=change-me
IZICRM_APP_PASSWORD=change-me
IZICRM_MIGRATOR_PASSWORD=change-me
IZICRM_MAINTENANCE_PASSWORD=change-me

# Приложение подключается только как izicrm_app — без BYPASSRLS и без DELETE.
DATABASE_URL=postgres://izicrm_app:change-me@localhost:5432/izicrm

# Суперпользователь: npm run migrate:up (bootstrap) и пароли ролей. Не для бота.
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/izicrm

# Роль izicrm_migrator владеет объектами схемы после bootstrap, сами миграции ею не гоняются.
DATABASE_MIGRATOR_URL=postgres://izicrm_migrator:change-me@localhost:5432/izicrm

# Очистка служебных таблиц — роль izicrm_maintenance (ADR-011). В боте не используется.
DATABASE_MAINTENANCE_URL=postgres://izicrm_maintenance:change-me@localhost:5432/izicrm

# Health-check слушает только localhost контейнера.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Веб-кабинет (те же данные, что в Telegram).
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Публичный URL для ссылки из бота. В проде только https:// — иначе cookie сессии без Secure.
# Пример локально: http://127.0.0.1:3000
WEB_PUBLIC_URL=
# TLS в самом Node (если нет прокси). Вместе с https:// в WEB_PUBLIC_URL включает Secure-cookie.
WEB_TLS_CERT_FILE=
WEB_TLS_KEY_FILE=
# Если пусто — подпись сессии берётся из TELEGRAM_BOT_TOKEN.
WEB_SESSION_SECRET=

# Операторы /admin. Пусто — команда никому не открывает отчёт.
ADMIN_TELEGRAM_IDS=8069167166,432654986

# Таймзона бизнес-даты по умолчанию (C-8).
TZ=Europe/Moscow
