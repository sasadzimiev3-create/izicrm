# Секреты — никогда не попадают в репозиторий.
# Токен бота и пароль к базе живут только на вашей машине и на сервере.
.env
.env.*
!.env.example

# Зависимости: восстанавливаются командой npm install
node_modules/

# Результат сборки
dist/
build/
*.tsbuildinfo

# Отчёты о покрытии тестами
coverage/
.vitest/

# Логи
logs/
*.log
npm-debug.log*

# Дампы и бэкапы базы: бывают на гигабайты, место им вне git
backups/
*.dump
*.sql.gz

# Сформированные Excel-отчёты пользователей: содержат финансовые данные
reports/
*.xlsx

# Временные файлы
tmp/
temp/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Редакторы. Каталог .cursor/rules намеренно НЕ игнорируется:
# правила проекта — часть проекта и должны быть в истории.
.vscode/
.idea/
*.swp
