[Unit]
Description=izicrm cleanup of processed_updates and expired dialog_states
Documentation=file:///opt/izicrm/deploy/README.md
Requires=izicrm.service
After=izicrm.service

[Service]
Type=oneshot
WorkingDirectory=/opt/izicrm
EnvironmentFile=/opt/izicrm/.env
ExecStart=/usr/bin/docker compose exec -T postgres /bin/sh /ops/gc.sh
